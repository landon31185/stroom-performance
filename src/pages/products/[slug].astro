---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ProductMedia from '../../components/ProductMedia.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getCatalogProducts, getProductDescription, formatMoney, statusLabels } from '../../lib/catalog';
import { site, systemName, raceStyleName, platformName } from '../../lib/site';

export async function getStaticPaths() {
  const products = await getCatalogProducts();
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product } = Astro.props;
const rendered = await getProductDescription(product);
const Content = rendered?.Content;
const isMerchandise = product.system === 'merchandise';
const catalog = await getCatalogProducts();
const relatedProducts = catalog
  .filter((candidate) => candidate.slug !== product.slug)
  .filter((candidate) =>
    candidate.system === product.system
    || candidate.platforms.some((platform) => product.platforms.includes(platform)))
  .slice(0, 3);

const confidenceLabel: Record<string, string> = {
  'verified-on-car': 'Verified on our car',
  'vendor-stated': 'Vendor-stated',
  inferred: 'Inferred — confirm before purchase',
};
const initialVariant = product.variants.find((variant) => variant.availableForSale) || product.variants[0];
const canBuy = product.source === 'shopify'
  && product.status === 'available'
  && product.availableForSale
  && initialVariant;
const purchasablePrice = canBuy ? initialVariant.price : undefined;
const offer = canBuy ? {
  '@type': 'Offer',
  availability: 'https://schema.org/InStock',
  url: `${site.url}/products/${product.slug}`,
  seller: { '@id': `${site.url}/#store` },
  price: purchasablePrice!.amount.toFixed(2),
  priceCurrency: purchasablePrice!.currencyCode,
} : undefined;
const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.title,
  description: product.summary,
  brand: { '@type': 'Brand', name: product.brand },
  ...(product.manufacturerPartNumber ? { mpn: product.manufacturerPartNumber, sku: product.manufacturerPartNumber } : {}),
  category: systemName(product.system),
  ...(product.image ? { image: product.image.startsWith('http') ? product.image : `${site.url}${product.image}` } : {}),
  ...(offer ? { offers: offer } : {}),
});
---

<BaseLayout
  title={`${product.title} | Stroom Performance`}
  description={product.summary}
  ogType="website"
  ogImage={product.image}
  schema={canBuy ? `<script type="application/ld+json">${schema}<\/script>` : undefined}
  noindex={product.status !== 'available'}
>
  <section class="product-hero">
    <div class="wrap product-hero__wrap">
      <div class="product-hero__copy">
        <Breadcrumb crumbs={[{ label: 'Home', href: '/' }, { label: 'Shop', href: '/shop' }, { label: systemName(product.system), href: `/collections/${product.system}` }, { label: product.title }]} />
        <div class="product-hero__identity">
          <p class="product-hero__brand">{product.brand}</p>
          <h1 class="heading-section product-hero__title">{product.title}</h1>
          <p class="body-large muted product-hero__body">{product.summary}</p>
        </div>
        <ProductMedia
          slug={product.slug}
          title={product.title}
          brand={product.brand}
          partNumber={product.manufacturerPartNumber}
          image={product.image}
          imageAlt={product.imageAlt}
          images={product.images}
          size="hero"
        />
        <div class="product-hero__tags reveal">
          <span class="tag">{systemName(product.system)}</span>
          {product.platforms.map((platform) => <span class="tag tag-platform">{platformName(platform)}</span>)}
          {product.raceStyles.map((style) => <span class="tag tag-hazard">{raceStyleName(style)}</span>)}
        </div>
      </div>

      <aside class="product-buybox reveal">
        <div class="product-buybox__status">
          <span>{canBuy ? 'Ready to order' : 'Catalog preview'}</span>
          <span class="readout">{statusLabels[product.status]}</span>
        </div>
        <p class:list={['product-buybox__price', { 'product-buybox__price--preview': !canBuy }]} data-product-price>
          {canBuy ? formatMoney(purchasablePrice) : product.price ? formatMoney(product.price) : 'Pricing to be confirmed'}
        </p>
        {canBuy ? (
          <form method="POST" action="/api/cart" data-add-to-cart class="product-buybox__form">
            <input type="hidden" name="action" value="add" />
            {product.variants.length > 1 ? (
              <label class="product-option">
                <span>Configuration</span>
                <select name="variantId" data-variant-select>
                  {product.variants.map((variant) => (
                    <option
                      value={variant.id}
                      disabled={!variant.availableForSale}
                      data-price={formatMoney(variant.price)}
                    >
                      {variant.title}{variant.availableForSale ? '' : ' — unavailable'}
                    </option>
                  ))}
                </select>
              </label>
            ) : (
              <input type="hidden" name="variantId" value={initialVariant.id} />
            )}
            <label class="product-quantity">
              <span>Quantity</span>
              <input type="number" name="quantity" value="1" min="1" max="10" inputmode="numeric" />
            </label>
            <button class="btn-primary product-buybox__cta" type="submit">Add to cart</button>
          </form>
        ) : (
          <div class="product-buybox__preview-actions">
            <a
              class="btn-primary product-buybox__cta"
              href={`mailto:${site.contactEmail}?subject=${encodeURIComponent(`Stroom product question: ${product.title}`)}`}
            >
              Ask about this part
            </a>
            <a class="btn-secondary product-buybox__secondary" href="/shop">Browse the catalog</a>
          </div>
        )}
        <p class="muted product-buybox__small">
          {canBuy
            ? 'Availability and secure checkout are provided by Shopify.'
            : 'This reference page is not a purchase offer. Final price, availability, and fulfillment will come from Shopify.'}
        </p>

        <dl class="product-buybox__facts">
          {product.manufacturerPartNumber && <><dt>Part number</dt><dd>{product.manufacturerPartNumber}</dd></>}
          <dt>Category</dt><dd>{systemName(product.system)}</dd>
          {product.platforms.length > 0 && <><dt>Engine family</dt><dd>{product.platforms.map(platformName).join(', ')}</dd></>}
        </dl>
      </aside>
    </div>
  </section>

  <section class="product-detail">
    <div class="wrap product-detail__wrap">
      <div class="product-detail__content">
        {product.fitment && (
          <section class="product-fitment" aria-labelledby="fitment-title">
            <div class="product-fitment__heading">
              <p class="label-small">Fitment review</p>
              <h2 id="fitment-title" class="heading-card">What must match</h2>
            </div>
            <dl class="product-fitment__list">
              <div><dt>Application</dt><dd>{product.fitment.application}</dd></div>
              {product.fitment.requiredMods.length > 0 && (
                <div><dt>Confirm before ordering</dt><dd>{product.fitment.requiredMods.join('; ')}</dd></div>
              )}
              <div><dt>Evidence</dt><dd>{confidenceLabel[product.fitment.confidence]}</dd></div>
            </dl>
            {product.fitment.notes && <p class="muted product-fitment__notes">{product.fitment.notes}</p>}
          </section>
        )}
        <div class="prose-section product-detail__prose">
          {Content ? <Content /> : <Fragment set:html={product.descriptionHtml || `<p>${product.summary}</p>`} />}
        </div>
        {product.specs.length > 0 && <div class="product-specs"><p class="label-small accent">Specifications</p><ul class="product-specs__list">{product.specs.map((spec) => <li>{spec}</li>)}</ul></div>}
      </div>
      <aside class="product-detail__rail">
        <div class="product-detail__rail-panel">
          <p class="label-small accent">{isMerchandise ? 'Product notes' : 'Selection notes'}</p>
          <p class="product-detail__rail-text">
            {isMerchandise
              ? 'Final price, materials, included hardware, and inventory will be confirmed before checkout opens.'
              : 'Review platform, supporting hardware, and intended use before ordering.'}
          </p>
          {product.manufacturerPartNumber && <p class="readout product-detail__mpn">MPN {product.manufacturerPartNumber}</p>}
          <a href={`mailto:${site.contactEmail}?subject=${encodeURIComponent(`Fitment question: ${product.title}`)}`} class="nav-link">
            Ask a fitment question →
          </a>
        </div>
      </aside>
    </div>
  </section>

  {relatedProducts.length > 0 && (
    <section class="product-related">
      <div class="wrap">
        <div class="product-related__heading">
          <div>
            <p class="label-small">Keep comparing</p>
            <h2 class="heading-section">Related catalog entries</h2>
          </div>
          <a href="/shop" class="nav-link">View all parts →</a>
        </div>
        <div class="product-related__grid">
          {relatedProducts.map((related) => (
            <ProductCard
              slug={related.slug}
              title={related.title}
              brand={related.brand}
              system={related.system}
              platforms={related.platforms}
              summary={related.summary}
              status={related.status}
              price={related.price}
              partNumber={related.manufacturerPartNumber}
              image={related.image}
              imageAlt={related.imageAlt}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  {canBuy && product.variants.length > 1 && (
    <script>
      document.addEventListener('change', (event) => {
        const select = (event.target as HTMLElement).closest<HTMLSelectElement>('[data-variant-select]');
        if (!select) return;
        const price = document.querySelector<HTMLElement>('[data-product-price]');
        const selected = select.selectedOptions[0];
        if (price && selected?.dataset.price) price.textContent = selected.dataset.price;
      });
    </script>
  )}
</BaseLayout>
